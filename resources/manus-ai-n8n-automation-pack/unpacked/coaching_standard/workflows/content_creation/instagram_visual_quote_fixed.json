{
  "name": "Instagram Visual Quote Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "days": [1, 3, 5],
              "hours": [12],
              "minutes": [0]
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "value": "YOUR_CONTENT_CALENDAR_SHEET_ID",
          "mode": "list",
          "cachedResultName": "Content Calendar"
        },
        "sheetName": "Content Calendar",
        "returnAll": false,
        "options": {
          "filter": {
            "values": {
              "Date": "={{ $today }}",
              "Platform": "Instagram"
            }
          }
        }
      },
      "name": "Google Sheets - Get Content Calendar",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "completion",
        "model": "gpt-4",
        "prompt": {
          "value": "Generate an inspirational quote about {% if $node[\"Google Sheets - Get Content Calendar\"].json.length > 0 %}{{ $node[\"Google Sheets - Get Content Calendar\"].json[0].Topic }}{% else %}personal growth, coaching, or professional development{% endif %}. The quote should be concise (under 120 characters), impactful, and motivational. It should be something that would resonate with professionals looking to improve themselves. Do not attribute the quote to anyone - it should be original."
        },
        "options": {
          "temperature": 0.8,
          "maxTokens": 200
        }
      },
      "name": "OpenAI - Generate Quote",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        550,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "design",
        "operation": "create",
        "designType": "social-media",
        "templateId": "YOUR_CANVA_TEMPLATE_ID",
        "elements": {
          "values": {
            "quoteText": "={{ $node[\"OpenAI - Generate Quote\"].json.text }}",
            "brandName": "Your Coaching Business",
            "brandLogo": "YOUR_LOGO_URL"
          }
        },
        "additionalFields": {
          "format": "png",
          "width": 1080,
          "height": 1080
        }
      },
      "name": "Canva - Create Quote Image",
      "type": "n8n-nodes-base.canva",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "resource": "mediaContainer",
        "mediaType": "IMAGE",
        "mediaUrl": "={{ $node[\"Canva - Create Quote Image\"].json.url }}",
        "additionalFields": {}
      },
      "name": "Instagram - Upload Media",
      "type": "n8n-nodes-base.instagram",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "resource": "mediaPublish",
        "mediaContainerId": "={{ $node[\"Instagram - Upload Media\"].json.id }}",
        "additionalFields": {
          "caption": "={{ $node[\"OpenAI - Generate Quote\"].json.text + \"\\n\\n#coaching #personalgrowth #professionaldevelopment #motivation #success\" }}"
        }
      },
      "name": "Instagram - Publish Post",
      "type": "n8n-nodes-base.instagram",
      "typeVersion": 1,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_TRACKING_SHEET_ID",
          "mode": "list",
          "cachedResultName": "Content Tracking"
        },
        "sheetName": "Content Tracking",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $now.toISOString().split('T')[0] }}",
            "Platform": "Instagram",
            "Content Type": "Quote",
            "Topic": "={{ $node[\"Google Sheets - Get Content Calendar\"].json.length > 0 ? $node[\"Google Sheets - Get Content Calendar\"].json[0].Topic : 'Inspirational Quote' }}",
            "Post ID": "={{ $node[\"Instagram - Publish Post\"].json.id }}",
            "Content": "={{ $node[\"OpenAI - Generate Quote\"].json.text }}"
          }
        }
      },
      "name": "Google Sheets - Log Post",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        1150,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_SLACK_CHANNEL_ID",
        "text": "✅ Instagram quote post published successfully!\n\n*Quote:* {{ $node[\"OpenAI - Generate Quote\"].json.text }}\n*Date:* {{ $now.toISOString().split('T')[0] }}",
        "otherOptions": {
          "parse_mode": "markdown",
          "disable_web_page_preview": true
        },
        "attachments": "={{ $node[\"Canva - Create Quote Image\"].json.url }}"
      },
      "name": "Slack - Send Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Google Sheets - Get Content Calendar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Get Content Calendar": {
      "main": [
        [
          {
            "node": "OpenAI - Generate Quote",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI - Generate Quote": {
      "main": [
        [
          {
            "node": "Canva - Create Quote Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Canva - Create Quote Image": {
      "main": [
        [
          {
            "node": "Instagram - Upload Media",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Instagram - Upload Media": {
      "main": [
        [
          {
            "node": "Instagram - Publish Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Instagram - Publish Post": {
      "main": [
        [
          {
            "node": "Google Sheets - Log Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Log Post": {
      "main": [
        [
          {
            "node": "Slack - Send Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "YOUR_ERROR_WORKFLOW_ID"
  },
  "tags": [
    "content-creation",
    "instagram"
  ],
  "triggerCount": 1
}
