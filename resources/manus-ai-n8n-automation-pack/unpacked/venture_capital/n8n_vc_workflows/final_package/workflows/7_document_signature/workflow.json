        }
      }
    },
    {
      "parameters": {
        "functionCode": "// Find pending signers\nconst documentData = $input.first().json;\nconst envelopeData = $input.last().json;\n\n// Extract recipients who haven't signed yet\nconst recipients = envelopeData.recipients || {};\nconst signers = recipients.signers || [];\n\n// Filter for pending signers\nconst pendingSigners = signers.filter(signer => \n  signer.status !== 'completed' && \n  signer.status !== 'declined'\n);\n\n// Create reminder data\nconst reminderData = {\n  ...documentData,\n  pendingSigners,\n  pendingSignerCount: pendingSigners.length,\n  pendingSignerEmails: pendingSigners.map(s => s.email).join(','),\n  reminderDate: new Date().toISOString(),\n  reminderType: documentData.daysToDue === 1 ? 'Urgent' : 'Standard',\n  reminderMessage: documentData.daysToDue === 1 ?\n    `URGENT: Your signature is required within 24 hours for \"${documentData.documentName}\"` :\n    `Reminder: Please sign \"${documentData.documentName}\" within ${documentData.daysToDue} days`\n};\n\nreturn { json: reminderData };"
      },
      "name": "Prepare Reminder",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1340,
        1100
      ]
    },
