    {
      "parameters": {
        "functionCode": "// Process DocuSign webhook\nconst data = $input.item.json;\n\n// Extract envelope data\nconst envelopeId = data.envelopeId || data.data?.envelopeId || '';\nconst status = data.status || data.data?.status || '';\nconst completedDate = data.completedDate || data.data?.completedDate || '';\nconst recipients = data.recipients || data.data?.recipients || {};\n\n// Create webhook response object\nconst webhookData = {\n  envelopeId,\n  status,\n  completedDate: completedDate ? new Date(completedDate).toISOString() : '',\n  recipients: JSON.stringify(recipients),\n  eventTimestamp: new Date().toISOString(),\n  eventType: status,\n  rawData: JSON.stringify(data)\n};\n\nreturn { json: webhookData };"
      },
      "name": "Process DocuSign Webhook",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        460,
        780
