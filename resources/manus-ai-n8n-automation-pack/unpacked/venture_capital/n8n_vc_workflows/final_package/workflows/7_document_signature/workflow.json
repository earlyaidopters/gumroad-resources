    {
      "parameters": {
        "functionCode": "// Update document status based on webhook\nconst webhookData = $input.first().json;\nconst documentData = $input.last().json;\n\n// Map DocuSign status to our status\nlet documentStatus = 'In Progress';\nswitch (webhookData.status) {\n  case 'completed':\n    documentStatus = 'Completed';\n    break;\n  case 'declined':\n    documentStatus = 'Declined';\n    break;\n  case 'voided':\n    documentStatus = 'Voided';\n    break;\n  case 'sent':\n    documentStatus = 'Sent for Signature';\n    break;\n  case 'delivered':\n    documentStatus = 'Delivered';\n    break;\n  default:\n    documentStatus = webhookData.status || 'In Progress';\n}\n\n// Combine data\nconst updatedDocumentData = {\n  ...documentData,\n  status: documentStatus,\n  completedDate: webhookData.completedDate || '',\n  lastUpdated: new Date().toISOString(),\n  webhookStatus: webhookData.status,\n  webhookTimestamp: webhookData.eventTimestamp\n};\n\nreturn { json: updatedDocumentData };"
      },
      "name": "Update Document Data",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        900,
        780
