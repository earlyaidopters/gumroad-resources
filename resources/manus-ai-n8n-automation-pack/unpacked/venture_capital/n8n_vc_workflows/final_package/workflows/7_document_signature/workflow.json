              "name": "={{ $json.documentName }}",
              "documentId": "1",
              "order": 1,
              "documentBase64": "={{ $binary.data.base64 }}"
            }
          ],
          "recipients": {
            "signers": "={{ $json.signers.map((signer, i) => ({ email: signer.email, name: signer.name, recipientId: (i+1).toString(), routingOrder: (i+1).toString() })) }}",
            "carbonCopies": "={{ $json.reviewers.map((reviewer, i) => ({ email: reviewer.email, name: reviewer.name, recipientId: ($json.signers.length + i + 1).toString(), routingOrder: ($json.signers.length + 1).toString() })) }}"
          },
          "status": "sent",
          "emailSubject": "={{ 'Please sign: ' + $json.documentName }}",
          "emailBlurb": "={{ 'Please review and sign this ' + $json.documentType + ' document.' }}"
