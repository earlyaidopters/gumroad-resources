    {
      "parameters": {
        "functionCode": "// Process document signature request\nconst data = $input.item.json;\n\n// Create a structured document request object\nconst docRequest = {\n  id: `DOC-${Date.now()}`,\n  requestDate: new Date().toISOString(),\n  documentName: data.documentName || 'Untitled Document',\n  documentType: data.documentType || 'Agreement',\n  companyName: data.companyName || '',\n  dealId: data.dealId || '',\n  stage: data.stage || 'Draft',\n  priority: data.priority || 'Normal',\n  dueDate: data.dueDate || new Date(Date.now() + 7*24*60*60*1000).toISOString(),\n  requestedBy: data.requestedBy || '',\n  signers: data.signers || [],\n  reviewers: data.reviewers || [],\n  documentUrl: data.documentUrl || '',\n  documentContent: data.documentContent || '',\n  templateId: data.templateId || '',\n  status: 'Initiated',\n  lastUpdated: new Date().toISOString()\n};\n\n// Ensure signers is an array of objects with email and name\nif (!Array.isArray(docRequest.signers)) {\n  docRequest.signers = [];\n}\n\nif (!Array.isArray(docRequest.reviewers)) {\n  docRequest.reviewers = [];\n}\n\n// Format signers and reviewers as strings for storage\ndocRequest.signersText = docRequest.signers.map(s => `${s.name} <${s.email}>`).join(', ');\ndocRequest.reviewersText = docRequest.reviewers.map(r => `${r.name} <${r.email}>`).join(', ');\n\nreturn { json: docRequest };"
      },
      "name": "Process Document Request",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
