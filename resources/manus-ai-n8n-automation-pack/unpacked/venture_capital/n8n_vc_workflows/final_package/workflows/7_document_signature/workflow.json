      "parameters": {
        "functionCode": "// Prepare document for DocuSign\nconst documentData = $input.first().json;\nconst documentFile = $input.last().json;\n\n// Update document data with file information\nconst updatedDocData = {\n  ...documentData,\n  documentId: documentFile.id,\n  documentUrl: documentFile.webViewLink,\n  documentName: documentFile.name,\n  status: 'Ready for Signature',\n  lastUpdated: new Date().toISOString()\n};\n\n// Parse signers if it's a string\nlet signers = documentData.signers;\nif (typeof signers === 'string') {\n  try {\n    signers = JSON.parse(signers);\n  } catch (e) {\n    signers = [];\n  }\n}\n\n// Ensure signers is an array\nif (!Array.isArray(signers)) {\n  signers = [];\n}\n\n// Add signers to updated document data\nupdatedDocData.signers = signers;\n\nreturn { json: updatedDocData };"
      },
      "name": "Prepare for Signature",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1560,
        300
      ]
