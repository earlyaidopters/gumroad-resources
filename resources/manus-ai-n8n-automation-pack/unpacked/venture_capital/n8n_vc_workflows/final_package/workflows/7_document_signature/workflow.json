    {
      "parameters": {
        "functionCode": "// Generate document status report\nconst documents = $input.item.json;\n\n// Get documents from the last 30 days\nconst thirtyDaysAgo = new Date();\nthirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);\n\nconst recentDocuments = documents.filter(doc => {\n  const requestDate = new Date(doc.requestDate);\n  return requestDate >= thirtyDaysAgo;\n});\n\n// Count documents by status\nconst statusCount = {};\nfor (const doc of recentDocuments) {\n  statusCount[doc.status] = (statusCount[doc.status] || 0) + 1;\n}\n\n// Count documents by type\nconst typeCount = {};\nfor (const doc of recentDocuments) {\n  typeCount[doc.documentType] = (typeCount[doc.documentType] || 0) + 1;\n}\n\n// Find overdue documents\nconst now = new Date();\nconst overdueDocuments = recentDocuments.filter(doc => {\n  if (doc.status === 'Completed' || doc.status === 'Voided' || doc.status === 'Declined') {\n    return false;\n  }\n  const dueDate = new Date(doc.dueDate);\n  return now > dueDate;\n});\n\n// Find documents due in the next 7 days\nconst sevenDaysFromNow = new Date();\nsevenDaysFromNow.setDate(sevenDaysFromNow.getDate() + 7);\n\nconst upcomingDocuments = recentDocuments.filter(doc => {\n  if (doc.status === 'Completed' || doc.status === 'Voided' || doc.status === 'Declined') {\n    return false;\n  }\n  const dueDate = new Date(doc.dueDate);\n  return dueDate > now && dueDate <= sevenDaysFromNow;\n});\n\n// Create report data\nconst reportData = {\n  reportDate: new Date().toISOString(),\n  reportPeriod: `Last 30 days (${thirtyDaysAgo.toLocaleDateString()} - ${new Date().toLocaleDateString()})`,\n  totalDocuments: recentDocuments.length,\n  completedDocuments: statusCount['Completed'] || 0,\n  pendingDocuments: (statusCount['Sent for Signature'] || 0) + (statusCount['In Progress'] || 0),\n  overdueDocuments: overdueDocuments.length,\n  upcomingDocuments: upcomingDocuments.length,\n  statusDistribution: JSON.stringify(statusCount),\n  typeDistribution: JSON.stringify(typeCount),\n  overdueList: overdueDocuments.map(d => `${d.documentName} (${d.companyName})`).join(', '),\n  upcomingList: upcomingDocuments.map(d => `${d.documentName} (${d.companyName})`).join(', ')\n};\n\nreturn { json: reportData };"
      },
      "name": "Generate Document Report",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        680,
        1260
      ]
