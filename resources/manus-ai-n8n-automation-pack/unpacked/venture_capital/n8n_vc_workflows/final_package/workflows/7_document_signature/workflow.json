    {
      "parameters": {
        "functionCode": "// Check for documents that need reminders\nconst pendingDocuments = $input.item.json;\n\n// If no pending documents, return empty\nif (!pendingDocuments) {\n  return { json: { needsReminder: false } };\n}\n\n// Check if document is approaching due date\nconst now = new Date();\nconst dueDate = new Date(pendingDocuments.dueDate);\nconst daysToDue = Math.floor((dueDate - now) / (24 * 60 * 60 * 1000));\n\n// Send reminder if 3 days or 1 day before due date\nconst needsReminder = daysToDue === 3 || daysToDue === 1;\n\nreturn {\n  json: {\n    ...pendingDocuments,\n    daysToDue,\n    needsReminder\n  }\n};"
      },
      "name": "Check for Reminders",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        680,
        1100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.needsReminder }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Needs Reminder?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        900,
        1100
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "envelope",
        "operation": "get",
        "envelopeId": "={{ $json.envelopeId }}"
      },
      "name": "Get Envelope Status",
      "type": "n8n-nodes-base.docuSign",
      "typeVersion": 1,
      "position": [
        1120,
        1100
