        "additionalFields": {}
      },
      "id": "6f0h6i3f-0807-7fg6-f4i0-h7e8i8f9e4f5",
      "name": "X - Post First Tweet",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Store the first tweet ID for replies\nconst firstTweetResponse = $input.item.json;\n\nreturn {\n  firstTweetId: firstTweetResponse.id,\n  firstTweetText: firstTweetResponse.text,\n  remainingTweets: $node[\"Code - Parse Thread\"].json.tweets.slice(1)\n};"
      },
      "id": "7g1i7j4g-1918-8gh7-g5j1-i8f9j9g0f5g6",
      "name": "Code - Prepare Thread",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1450,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Process each tweet in the thread\nconst currentIndex = $input.item.index;\nconst remainingTweets = $input.item.json.remainingTweets;\n\nif (currentIndex < remainingTweets.length) {\n  return {\n    tweetText: remainingTweets[currentIndex],\n    tweetIndex: currentIndex + 1,\n    inReplyToId: $input.item.json.firstTweetId\n  };\n} else {\n  return {\n    tweetText: null,\n    tweetIndex: currentIndex + 1,\n    inReplyToId: $input.item.json.firstTweetId\n  };\n}"
      },
      "id": "8h2j8k5h-2029-9hi8-h6k2-j9g0k0h1g6h7",
