      "id": "2b6d2f9b-6463-4bc2-b0f6-d3a3f4b4a0b1",
      "name": "Google Sheets - Get Topics",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [
        450,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_CREDENTIAL_ID_PLACEHOLDER",
          "name": "Google Sheets Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Select a random topic from the Google Sheet\nconst items = $input.all();\nconst topics = items.map(item => item.json);\n\n// Filter out any empty rows\nconst validTopics = topics.filter(topic => \n  topic.topic && topic.topic.trim() !== '' && \n  topic.description && topic.description.trim() !== ''\n);\n\n// Select a random topic\nconst randomIndex = Math.floor(Math.random() * validTopics.length);\nconst selectedTopic = validTopics[randomIndex] || {\n  topic: \"Personal Growth Through Coaching\",\n  description: \"How coaching can accelerate personal development and transformation\"\n};\n\nreturn {\n  topic: selectedTopic.topic,\n  description: selectedTopic.description,\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "3c7e3f0c-7574-4cd3-c1f7-e4b4f5c5b1c2",
      "name": "Code - Select Topic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialName": "OpenAI API Key",
        "operation": "message",
        "model": "gpt-4",
        "options": {
          "temperature": 0.7,
          "maxTokens": 1500
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert at creating engaging Twitter threads about coaching topics. Your threads should be informative, conversational, and provide valuable insights that position the author as a thought leader in the coaching industry."
            },
            {
              "role": "user",
              "content": "=Create a Twitter thread (5-7 tweets) on the topic of \"{{$node[\"Code - Select Topic\"].json[\"topic\"]}}\".\n\nDescription: {{$node[\"Code - Select Topic\"].json[\"description\"]}}\n\nEach tweet should be under 280 characters. The first tweet should hook the reader, and the last tweet should include a call to action. Make the thread cohesive, informative, and engaging. Format your response with one tweet per line, with \"Tweet 1:\", \"Tweet 2:\", etc. at the beginning of each line."
            }
          ]
        }
      },
      "id": "4d8f4g1d-8685-5de4-d2g8-f5c6g6d7c2d3",
      "name": "OpenAI - Generate Thread",
      "type": "n8n-nodes-langchain.openai",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the thread from OpenAI response\nconst content = $input.item.json.text || $input.item.json.content;\n\n// Split the content into individual tweets\nconst tweetRegex = /Tweet \\d+:\\s*(.+?)(?=\\s*Tweet \\d+:|$)/gs;\nlet matches = [];\nlet match;\n\nwhile ((match = tweetRegex.exec(content)) !== null) {\n  if (match[1].trim() !== '') {\n    matches.push(match[1].trim());\n  }\n}\n\n// If regex didn't work, try simple line splitting\nif (matches.length === 0) {\n  const lines = content.split('\\n').filter(line => line.trim() !== '');\n  matches = lines.map(line => {\n    // Remove \"Tweet X:\" prefix if present\n    return line.replace(/^Tweet \\d+:\\s*/, '').trim();\n  });\n}\n\n// Ensure we have at least one tweet\nif (matches.length === 0) {\n  matches = [\"The journey of coaching begins with understanding yourself before you can help others grow. #coaching #personaldevelopment\"];\n}\n\n// Add hashtags to the last tweet if not present\nlet lastTweet = matches[matches.length - 1];\nif (!lastTweet.includes('#')) {\n  lastTweet += \" #coaching #leadership #personalgrowth\";\n  matches[matches.length - 1] = lastTweet;\n}\n\nreturn {\n  tweets: matches,\n  tweetCount: matches.length,\n  topic: $node[\"Code - Select Topic\"].json.topic\n};"
      },
      "id": "5e9g5h2e-9796-6ef5-e3h9-g6d7h7e8d3e4",
      "name": "Code - Parse Thread",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1050,
