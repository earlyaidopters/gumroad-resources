        "mode": "runOnceForEachItem",
        "jsCode": "// Process each registration individually\nconst registrations = $node[\"Code - Process Registrations\"].json.registrations;\nconst currentIndex = $input.item.index;\n\nif (currentIndex < registrations.length) {\n  return registrations[currentIndex];\n} else {\n  return {};\n}"
      },
