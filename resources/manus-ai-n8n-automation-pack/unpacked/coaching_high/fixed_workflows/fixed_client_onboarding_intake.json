      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Process each intake form submission individually\nconst submissions = $node[\"Code - Process Intake Forms\"].json.submissions;\nconst currentIndex = $input.item.index;\n\nif (currentIndex < submissions.length) {\n  return submissions[currentIndex];\n} else {\n  return {};\n}"
      },
