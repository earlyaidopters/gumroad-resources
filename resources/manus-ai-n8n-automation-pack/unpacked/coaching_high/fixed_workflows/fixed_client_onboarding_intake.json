        "jsCode": "// Find clients who need reminders\nconst onboardingStatus = $node[\"Google Sheets - Check Pending Intakes\"].json;\n\n// Find clients who received welcome email but haven't completed intake form\nconst needsIntakeReminder = [];\nconst now = new Date();\n\nonboardingStatus.forEach((status, index) => {\n  if (status.welcome_email_sent === 'Yes' && status.intake_form_completed !== 'Yes') {\n    // Check if welcome email was sent more than 3 days ago\n    const emailDate = new Date(status.date);\n    const daysSinceEmail = Math.floor((now - emailDate) / (1000 * 60 * 60 * 24));\n    \n    if (daysSinceEmail >= 3) {\n      needsIntakeReminder.push({\n        clientId: status.client_id,\n        firstName: status.first_name,\n        lastName: status.last_name,\n        email: status.email,\n        daysSinceEmail,\n        rowIndex: index + 2 // +2 for header row and 1-based indexing\n      });\n    }\n  }\n});\n\nreturn {\n  totalNeedsReminder: needsIntakeReminder.length,\n  reminders: needsIntakeReminder\n};"
      },
