      "parameters": {
        "jsCode": "// Process new client registrations\nconst registrations = $input.all().map(item => item.json);\n\n// Filter for new registrations that haven't been processed\nconst newRegistrations = registrations.filter(reg => \n  reg.status && reg.status.toLowerCase() === 'new' && \n  reg.email && reg.email.includes('@')\n);\n\n// Format the registrations for processing\nconst formattedRegistrations = newRegistrations.map(reg => ({\n  id: reg.id || `REG-${Date.now()}-${Math.floor(Math.random() * 1000)}`,\n  firstName: reg.first_name || reg.firstName || '',\n  lastName: reg.last_name || reg.lastName || '',\n  email: reg.email || '',\n  phone: reg.phone || '',\n  coachingInterest: reg.coaching_interest || reg.coachingInterest || 'General',\n  source: reg.source || 'Website',\n  registrationDate: reg.registration_date || reg.registrationDate || new Date().toISOString().split('T')[0],\n  rowIndex: registrations.indexOf(reg) + 2 // +2 for header row and 1-based indexing\n}));\n\nreturn {\n  totalNewRegistrations: formattedRegistrations.length,\n  registrations: formattedRegistrations\n};"
      },
      "id": "2b6d2f9b-6463-4bc2-b0f6-d3a3f4b4a0b1",
      "name": "Code - Process Registrations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
