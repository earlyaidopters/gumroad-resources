    {
      "parameters": {
        "jsCode": "// Process intake form submissions\nconst intakeForms = $node[\"Google Sheets - Check Intake Forms\"].json;\nconst onboardingStatus = $node[\"Google Sheets - Get Onboarding Status\"].json;\n\n// Create a map of client IDs to onboarding status\nconst onboardingMap = new Map();\nonboardingStatus.forEach((status, index) => {\n  if (status.client_id && status.intake_form_completed !== 'Yes') {\n    onboardingMap.set(status.client_id, {\n      ...status,\n      rowIndex: index + 2 // +2 for header row and 1-based indexing\n    });\n  }\n});\n\n// Find new intake form submissions\nconst newSubmissions = [];\nintakeForms.forEach(form => {\n  if (form.client_id && onboardingMap.has(form.client_id)) {\n    const clientStatus = onboardingMap.get(form.client_id);\n    newSubmissions.push({\n      clientId: form.client_id,\n      firstName: form.first_name || clientStatus.first_name,\n      lastName: form.last_name || clientStatus.last_name,\n      email: form.email || clientStatus.email,\n      phone: form.phone || '',\n      coachingGoals: form.coaching_goals || '',\n      preferredSchedule: form.preferred_schedule || '',\n      additionalInfo: form.additional_info || '',\n      submissionDate: form.submission_date || new Date().toISOString().split('T')[0],\n      onboardingRowIndex: clientStatus.rowIndex\n    });\n  }\n});\n\nreturn {\n  totalNewSubmissions: newSubmissions.length,\n  submissions: newSubmissions\n};"
      },
      "id": "0j4l0m7j-4241-1jk0-j8m4-l1i2m2j3i8j9",
      "name": "Code - Process Intake Forms",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        650,
        600
      ]
    },
