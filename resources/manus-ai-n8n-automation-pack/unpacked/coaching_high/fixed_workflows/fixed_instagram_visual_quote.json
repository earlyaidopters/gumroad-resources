    {
      "parameters": {
        "jsCode": "// Process the Canva response and prepare for Instagram posting\n// In a real implementation, this would handle downloading the image\n// and preparing it for Instagram's API requirements\n\n// Simulate image processing\nconst canvaResponse = $input.item.json;\nconst designId = canvaResponse.id || 'sample-design-id';\nconst designUrl = canvaResponse.url || 'https://example.com/design.jpg';\n\n// In a real implementation, we would download the image here\n// and process it to meet Instagram's requirements\n\nreturn {\n  designId,\n  designUrl,\n  imageBase64: \"PLACEHOLDER_FOR_BASE64_IMAGE_DATA\", // This would be real image data\n  caption: `${$node[\"Code - Parse Quotes\"].json.selectedQuote}\\n\\n—${$node[\"Code - Parse Quotes\"].json.author}\\n\\n#coaching #inspiration #growth #leadership #motivation`\n};"
      },
      "id": "5e9g5h2e-9796-6ef5-e3h9-g6d7h7e8d3e4",
