    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialName": "OpenAI API Key",
        "operation": "message",
        "model": "gpt-4",
        "options": {
          "temperature": 0.8,
          "maxTokens": 500
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert at creating inspirational and motivational quotes for coaches and their clients. Your quotes should be concise, impactful, and relevant to personal growth, leadership, and transformation."
            },
            {
              "role": "user",
              "content": "Generate 3 inspirational quotes about personal growth, coaching, or leadership. Each quote should be between 10-20 words and be impactful enough to stand alone on a visual image. Make them original and thought-provoking."
            }
          ]
        }
      },
      "id": "2b6d2f9b-6463-4bc2-b0f6-d3a3f4b4a0b1",
      "name": "OpenAI - Generate Quotes",
      "type": "n8n-nodes-langchain.openai",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the quotes from OpenAI response\nconst content = $input.item.json.text || $input.item.json.content;\n\n// Split the content into individual quotes\nconst quoteRegex = /(\\d+\\.\\s*|\"|\\'|"|"|'|')([^\"\\n]+)(\"|\\'|"|"|'|')/g;\nlet matches = [];\nlet match;\n\nwhile ((match = quoteRegex.exec(content)) !== null) {\n  matches.push(match[2].trim());\n}\n\n// If regex didn't work, try simple line splitting\nif (matches.length === 0) {\n  const lines = content.split('\\n').filter(line => line.trim() !== '');\n  matches = lines.map(line => {\n    // Remove numbers and special characters\n    return line.replace(/^\\d+\\.\\s*/, '').replace(/[\"'""'']/g, '').trim();\n  });\n}\n\n// Ensure we have at least one quote\nif (matches.length === 0) {\n  matches = [\"Your journey of transformation begins with a single step toward self-awareness.\"];\n}\n\n// Select the first quote for this run\nconst selectedQuote = matches[0];\n\n// Store all quotes for potential future use\nreturn {\n  selectedQuote,\n  allQuotes: matches,\n  author: \"Your Coaching Business\" // Can be customized\n};"
      },
      "id": "3c7e3f0c-7574-4cd3-c1f7-e4b4f5c5b1c2",
      "name": "Code - Parse Quotes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
