              "value": "=Instagram Quote - {{$now.format(\"YYYY-MM-DD\")}}"
            },
            {
              "name": "text_elements",
              "value": "=[\n  {\n    \"element_id\": \"quote_text\",\n    \"text\": {{$node[\"Code - Parse Quotes\"].json[\"selectedQuote\"]}}\n  },\n  {\n    \"element_id\": \"author\",\n    \"text\": {{$node[\"Code - Parse Quotes\"].json[\"author\"]}}\n  }\n]"
            },
            {
              "name": "brand_options",
              "value": "{\n  \"colors\": [\"#4A90E2\", \"#50E3C2\", \"#B8E986\"],\n  \"fonts\": [\"Montserrat\", \"Open Sans\"]\n}"
            }
          ]
        },
        "options": {}
      },
      "id": "4d8f4g1d-8685-5de4-d2g8-f5c6g6d7c2d3",
      "name": "HTTP Request - Canva Design",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
