        "channel": "coaching-automation-alerts",
        "text": "=⚠️ ERROR: LinkedIn thought leadership post failed to publish at {{$now.format(\"YYYY-MM-DD HH:mm:ss\")}}.\n\nError details: {{$node[\"LinkedIn - Post Content\"].json.error}}",
        "otherOptions": {}
      },
      "id": "8h2j8k5h-2029-9hi8-h6k2-j9g0k0h1g6h7",
      "name": "Slack - Send Error",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        1250,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "// Store the content in Google Sheets as a backup\n// This is a placeholder for actual Google Sheets integration\n// In a real implementation, this would use the Google Sheets node\n\nreturn {\n  status: \"Content stored for retry\",\n  timestamp: new Date().toISOString(),\n  content: $input.item.json.fullContent,\n  error: $node[\"LinkedIn - Post Content\"].json.error\n};"
      },
      "id": "9i3k9l6i-3130-0ij9-i7l3-k0h1l1i2h7i8",
