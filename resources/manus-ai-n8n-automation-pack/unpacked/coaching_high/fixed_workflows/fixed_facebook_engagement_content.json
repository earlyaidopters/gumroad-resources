    {
      "parameters": {
        "jsCode": "// Process the Canva response and prepare for Facebook posting\n// In a real implementation, this would handle downloading the image\n\n// Simulate image processing\nconst canvaResponse = $input.item.json;\nconst designId = canvaResponse.id || 'sample-design-id';\nconst designUrl = canvaResponse.url || 'https://example.com/design.jpg';\n\n// In a real implementation, we would download the image here\n\nreturn {\n  designId,\n  designUrl,\n  hasVisual: true,\n  content: $node[\"OpenAI - Generate Content\"].json.text || $node[\"OpenAI - Generate Content\"].json.content\n};"
      },
      "id": "7g1i7j4g-1918-8gh7-g5j1-i8f9j9g0f5g6",
