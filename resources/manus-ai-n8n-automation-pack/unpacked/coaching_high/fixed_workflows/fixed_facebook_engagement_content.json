      "parameters": {
        "jsCode": "// Store post ID and details for engagement tracking\nconst postResponse = $input.item.json;\nconst postId = postResponse.id || null;\n\nreturn {\n  postId,\n  timestamp: new Date().toISOString(),\n  topic: $node[\"Code - Select Topic\"].json.topic,\n  content: $node[\"Code - Merge Content\"].json.content.substring(0, 100) + '...',\n  hasVisual: $node[\"Code - Merge Content\"].json.hasVisual\n};"
