        "jsCode": "// Merge content from either visual or non-visual path\nconst input = $input.item.json;\n\nreturn {\n  hasVisual: input.hasVisual,\n  content: input.content,\n  designUrl: input.designUrl || null,\n  designId: input.designId || null,\n  topic: $node[\"Code - Select Topic\"].json.topic\n};"
      },
