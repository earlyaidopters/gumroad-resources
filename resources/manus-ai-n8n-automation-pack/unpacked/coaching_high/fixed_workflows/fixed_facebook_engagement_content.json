    {
      "parameters": {
        "jsCode": "// Select a topic from the Google Sheet based on date rotation\nconst items = $input.all();\nconst topics = items.map(item => item.json);\n\n// Filter out any empty rows\nconst validTopics = topics.filter(topic => \n  topic.topic && topic.topic.trim() !== '' && \n  topic.description && topic.description.trim() !== ''\n);\n\n// Use the current week number to rotate through topics\nconst now = new Date();\nconst startOfYear = new Date(now.getFullYear(), 0, 1);\nconst days = Math.floor((now - startOfYear) / (24 * 60 * 60 * 1000));\nconst weekNumber = Math.ceil(days / 7);\n\n// Select topic based on week number\nconst topicIndex = weekNumber % validTopics.length;\nconst selectedTopic = validTopics[topicIndex] || {\n  topic: \"Client Engagement Strategies\",\n  description: \"Effective ways to engage with coaching clients\",\n  include_visual: \"yes\"\n};\n\nreturn {\n  topic: selectedTopic.topic,\n  description: selectedTopic.description,\n  includeVisual: selectedTopic.include_visual === 'yes',\n  timestamp: new Date().toISOString(),\n  weekNumber: weekNumber\n};"
      },
      "id": "3c7e3f0c-7574-4cd3-c1f7-e4b4f5c5b1c2",
      "name": "Code - Select Topic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialName": "OpenAI API Key",
        "operation": "message",
        "model": "gpt-4",
        "options": {
          "temperature": 0.8,
          "maxTokens": 1000
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert at creating engaging Facebook posts for coaching businesses. Your posts should be conversational, include questions or calls to action, and encourage audience engagement."
            },
            {
              "role": "user",
              "content": "=Create an engaging Facebook post for a coaching business on the topic of \"{{$node[\"Code - Select Topic\"].json[\"topic\"]}}\".\n\nDescription: {{$node[\"Code - Select Topic\"].json[\"description\"]}}\n\nThe post should be between 100-250 words, include at least one question or call to action to encourage engagement, and end with 3-5 relevant hashtags. Make the tone conversational and approachable."
            }
          ]
        }
      },
