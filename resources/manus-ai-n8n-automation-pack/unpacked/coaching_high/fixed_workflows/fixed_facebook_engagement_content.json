              "name": "text_elements",
              "value": "=[\n  {\n    \"element_id\": \"title\",\n    \"text\": {{$node[\"Code - Select Topic\"].json[\"topic\"]}}\n  },\n  {\n    \"element_id\": \"subtitle\",\n    \"text\": \"Coaching Insights\"\n  }\n]"
            },
