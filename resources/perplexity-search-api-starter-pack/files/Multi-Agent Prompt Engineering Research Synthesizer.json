    {
      "parameters": {
        "promptType": "define",
        "text": "=User request: {{ $json.chatInput }}\n\nIf this request needs clarification to research effectively, immediately ask specific questions to narrow the scope.\n\nIf the request is clear enough, proceed directly to research by:\n1. Delegating specific queries to each of your three agents:\n   - Academic Agent: theoretical research and scholarly findings\n   - Practical Agent: real-world examples and implementations  \n   - Innovation Agent: cutting-edge developments and experimental approaches\n\n2. After receiving all responses, synthesize them into a unified answer that:\n   - Identifies key patterns and insights across all sources\n   - Highlights any contradictions or debates\n   - Provides actionable recommendations\n   - Explains the reasoning behind major findings\n\nEither ask for clarification OR proceed with research. Do not explain your decision-making process.",
        "options": {
          "systemMessage": "You are a research coordinator that synthesizes findings from specialized research agents. Your role is to: 1) Delegate research tasks to your three specialized agents (Academic, Practical, Innovation) 2) Analyze and combine their findings 3) Provide comprehensive prompt engineering insights that integrate academic theory, practical examples, and cutting-edge innovations. Always use all three agents before providing your final synthesis."
        }
      },
      "id": "b089fb55-7ff8-4ffa-923c-6e95a7b7343c",
      "name": "Main Research Coordinator Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        624,
        -96
      ]
    },
    {
      "parameters": {
        "toolDescription": "Academic Research Agent - Searches academic papers and theoretical frameworks",
        "text": "={{ $('Chat Trigger').item.json.chatInput }}",
        "options": {
          "systemMessage": "You are an academic research specialist focused on prompt engineering. Your expertise includes: 1) Academic papers and research studies on prompt engineering 2) Theoretical frameworks and methodologies 3) Peer-reviewed findings and scientific approaches 4) Citation of credible academic sources. Use your Perplexity search tool to find academic papers, research studies, and theoretical frameworks related to the user query. Focus on scholarly sources and peer-reviewed content."
        }
      },
      "id": "316efca1-5b5e-482e-84e2-4f3d60b3aa8c",
      "name": "Academic Research Agent",
