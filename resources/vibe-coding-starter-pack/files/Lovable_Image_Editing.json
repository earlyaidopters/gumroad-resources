      "parameters": {
        "jsCode": "return items.map(item => {\n  const dataUri = item.json.body.image || '';           // \"data:image/png;base64,AAAA…\"\n  const base64   = dataUri.includes(',') ? dataUri.split(',')[1] : dataUri;\n\n  item.binary = item.binary || {};\n  item.binary.image = {\n    data:      base64,\n    fileName:  'input.png',\n    mimeType:  'image/png',\n  };\n\n  return item;\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
