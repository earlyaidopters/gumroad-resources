      "id": "1b7a8fb4-a97d-4d8a-a5db-ca3ee1627290",
      "name": "🤝 Prep the Image"
    },
    {
      "parameters": {
        "jsCode": "/**\n * n8n Code node\n * Mode: “Run Once for All Items”\n *\n * Converts data[0].b64_json → binary.image (PNG)\n * so the next node (e.g. “HTTP Response” or “Write Binary File”)\n * can download `edited.png`.\n */\n\nreturn items.map(item => {\n  // 1. grab base-64 string (adjust the path if yours differs)\n  const b64 = item.json.data[0].b64_json;\n\n  // 2. attach it as a binary file\n  item.binary = item.binary || {};\n  item.binary.image = {\n    data:      b64,              // raw base-64\n    fileName:  'edited.png',\n    mimeType:  'image/png',\n  };\n\n  return item;                   // keep the item flowing\n});\n"
      },
