# Run python3 tools/configure.py to create .env with a fresh local device token.
STACKCHAN_TOKEN=
ANTHROPIC_API_KEY=
FISH_AUDIO_API_KEY=
STACKCHAN_FISH_VOICE_OWNER=
STACKCHAN_FISH_MODEL=drama-3
# Set to your Mac's private LAN address so the physical robot can connect.
HOST=127.0.0.1
VISION_HOST=127.0.0.1
MCP_HTTP_HOST=127.0.0.1
LILTOKEN_TIMEZONE=UTC
LILTOKEN_AGENT_MODEL=sonnet
FIRECRAWL_API_KEY=
# Advanced features are explicit opt-ins.
LILTOKEN_COMPOSIO=off
COMPOSIO_API_KEY=
LILTOKEN_GOOGLE=0
GOOGLE_ACCESS_TOKEN=
LILTOKEN_BUSINESS=0
STRIPE_SECRET_KEY=
GUMROAD_ACCESS_TOKEN=
LILTOKEN_CODE_TASKS=0
LILTOKEN_MUSIC=0
LILTOKEN_PRESENCE=0
LILTOKEN_SALES=0
LILTOKEN_MILESTONES=0
LILTOKEN_MORNING=0
LILTOKEN_COACH=0
LILTOKEN_LIGHTS=0
STACKCHAN_WAKE_SPOTTER=0
LILTOKEN_SONG_NAME=0
GOOGLE_API_KEY=
LILTOKEN_SAVE_TRANSCRIPTS=0
LILTOKEN_EYE_CONTACT=0
