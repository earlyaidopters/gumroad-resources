+// ---------------------------------------------------------------------------
+// Lil Token sensors: BMI270 accelerometer (0x69) and LTR-553 proximity/light
+// (0x23) on the internal I2C bus. Emits stackchan-event "motion" (shake,
+// picked_up, put_down, tipped, upright) and "proximity" (wave) to the gateway.
+// ---------------------------------------------------------------------------
+extern "C" const uint8_t bmi270_config_file[];
