+
+async def push_wake_event(
+    hook_url: str,
+    token: str,
+    *,
+    session_id: str = "",
+    wake_word: str = "",
+    timeout_s: float = 5.0,
+) -> bool:
+    """POST a JSON wake notification to the hook URL (Lil Token mode).
+
+    Used when ``STACKCHAN_AUDIO_HOOK_MODE=wake``: instead of buffering the
+    device's open-ended listen stream, the gateway ends the device-side
+    listen at once and tells the receiver that the robot was woken. The
+    receiver then runs its own turn (prompt, fixed-length ``listen()``,
+    answer) through the MCP tools.
+    """
+    headers = {"X-StackChan-Session": session_id}
+    if token:
+        headers["Authorization"] = f"Bearer {token}"
+    payload = {"event": "wake", "session_id": session_id, "wake_word": wake_word}
+    try:
+        async with aiohttp.ClientSession() as session:
+            async with session.post(
+                hook_url,
+                json=payload,
+                headers=headers,
+                timeout=aiohttp.ClientTimeout(total=timeout_s),
+            ) as response:
+                ok = 200 <= response.status < 300
+                log = logger.info if ok else logger.warning
+                log(
+                    "audio_input_hook: wake event session=%s status=%d",
+                    session_id, response.status,
+                )
+                return ok
+    except Exception as exc:
+        logger.warning(
+            "audio_input_hook: wake event POST failed session=%s: %s",
