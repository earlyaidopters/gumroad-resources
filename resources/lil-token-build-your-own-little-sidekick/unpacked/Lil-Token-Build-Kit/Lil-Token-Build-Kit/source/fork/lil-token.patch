+def measure_speech(pcm: bytes, sample_rate: int = DEVICE_SAMPLE_RATE) -> dict:
+    """Rough voice-activity measure on 16-bit mono PCM (30 ms windows).
+
+    A window counts as speech when it is at least
+    STACKCHAN_LISTEN_MARGIN_DB (default 12) above the quiet floor (10th
+    percentile of window levels) and above STACKCHAN_LISTEN_MIN_DBFS
+    (default -45).
+    """
+    import array
+    import math
+
+    samples = array.array("h")
+    samples.frombytes(pcm[: len(pcm) - len(pcm) % 2])
+    # Skip the firmware's listening-start beep at the head of the capture.
+    skip = sample_rate * int(os.environ.get("STACKCHAN_LISTEN_SKIP_MS", "450")) // 1000
+    samples = samples[skip:]
+    win = sample_rate * 30 // 1000
+    levels = []
+    for i in range(0, len(samples) - win + 1, win):
+        chunk = samples[i : i + win]
+        ms = sum(v * v for v in chunk) / win
+        levels.append(20 * math.log10(math.sqrt(ms) / 32768.0) if ms > 0 else -120.0)
+    if not levels:
+        return {"speech_ms": 0, "peak_dbfs": -120.0, "floor_dbfs": -120.0}
+    ordered = sorted(levels)
+    floor = ordered[len(ordered) // 10]
+    margin = float(os.environ.get("STACKCHAN_LISTEN_MARGIN_DB", "12"))
+    min_dbfs = float(os.environ.get("STACKCHAN_LISTEN_MIN_DBFS", "-45"))
+    threshold = max(min_dbfs, floor + margin)
+    speech_windows = sum(1 for lv in levels if lv >= threshold)
+    return {"speech_ms": speech_windows * 30, "peak_dbfs": max(levels), "floor_dbfs": floor}
+
+
+def _save_listen_wav(pcm: bytes, directory: str, keep: int = 30) -> None:
+    """Keep the last few listen captures as WAV files for level tuning."""
+    import time
+    import wave
+    from pathlib import Path
+
+    try:
+        d = Path(directory).expanduser()
+        d.mkdir(parents=True, exist_ok=True)
+        path = d / time.strftime("listen-%Y%m%d-%H%M%S.wav")
+        with wave.open(str(path), "wb") as w:
+            w.setnchannels(1)
+            w.setsampwidth(2)
+            w.setframerate(DEVICE_SAMPLE_RATE)
+            w.writeframes(pcm)
+        for old in sorted(d.glob("listen-*.wav"))[:-keep]:
+            old.unlink()
+    except Exception as exc:  # pragma: no cover - debug aid only
+        logger.debug("listen wav save failed: %s", exc)
