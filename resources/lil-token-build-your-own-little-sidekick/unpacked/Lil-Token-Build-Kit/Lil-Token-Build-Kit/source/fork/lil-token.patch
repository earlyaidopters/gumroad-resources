+class LilTokenSensors {
+public:
+    explicit LilTokenSensors(i2c_master_bus_handle_t bus) {
+        i2c_device_config_t cfg = {};
+        cfg.dev_addr_length = I2C_ADDR_BIT_LEN_7;
+        cfg.scl_speed_hz = 400000;
+        cfg.device_address = 0x69;
+        imu_dev_ = i2c_master_bus_add_device(bus, &cfg, &bmi_) == ESP_OK;
+        cfg.device_address = 0x23;
+        ltr_dev_ = i2c_master_bus_add_device(bus, &cfg, &ltr_) == ESP_OK;
+    }
+
+    // Safe to call again after a failure: I2C errors no longer reboot the
+    // robot, so a busy bus during the 8 KB config upload used to leave the
+    // IMU off until the next power cycle (Lil Token, 2026-10-21).
+    bool InitImu() {
+        imu_ok_ = false;
+        if (!imu_dev_) return false;
+        uint8_t id = 0;
+        if (!Read(bmi_, 0x00, &id, 1) || id != 0x24) {
+            ESP_LOGW("LilTokenSensors", "BMI270 chip id 0x%02X (expected 0x24)", id);
+            return imu_ok_ = false;
+        }
+        // Soft reset first: the BMI270 keeps power across an ESP32 reset, and
+        // re-uploading the config onto an already-initialised chip fails with
+        // INTERNAL_STATUS 0x02 (seen 2026-10-21 after a 16:14 restart).
+        Write(bmi_, 0x7E, 0xB6);  // CMD: softreset
+        vTaskDelay(pdMS_TO_TICKS(20));
+        id = 0;
+        Read(bmi_, 0x00, &id, 1);  // first access after reset
+        bool pc = Write(bmi_, 0x7C, 0x00);  // PWR_CONF: advanced power save off
+        vTaskDelay(pdMS_TO_TICKS(5));
+        ESP_LOGI("LilTokenSensors", "BMI270 after reset: id=0x%02X pwr_conf_write=%d", id, pc);
+        Write(bmi_, 0x59, 0x00);  // INIT_CTRL: start config load
+        const size_t total = 8192, chunk = 64;
+        uint8_t buf[chunk + 1];
+        for (size_t off = 0; off < total; off += chunk) {
+            uint16_t word = off / 2;
+            Write(bmi_, 0x5B, word & 0x0F);
+            Write(bmi_, 0x5C, word >> 4);
+            buf[0] = 0x5E;
+            memcpy(buf + 1, bmi270_config_file + off, chunk);
+            esp_err_t werr = ESP_FAIL;
+            for (int t = 0; t < 3 && werr != ESP_OK; ++t) {
+                if (t) vTaskDelay(pdMS_TO_TICKS(5));
+                werr = i2c_master_transmit(bmi_, buf, chunk + 1, 100);
+            }
+            if (werr != ESP_OK) {
+                ESP_LOGW("LilTokenSensors", "BMI270 config write failed at %u: 0x%X", (unsigned)off, werr);
+                return imu_ok_ = false;
+            }
+        }
+        Write(bmi_, 0x59, 0x01);  // INIT_CTRL: done
+        vTaskDelay(pdMS_TO_TICKS(30));
+        uint8_t status = 0;
+        Read(bmi_, 0x21, &status, 1);
+        if ((status & 0x0F) != 0x01) {
+            ESP_LOGW("LilTokenSensors", "BMI270 init status 0x%02X", status);
+            return imu_ok_ = false;
+        }
+        Write(bmi_, 0x7D, 0x04);  // PWR_CTRL: accel on
+        Write(bmi_, 0x40, 0xA8);  // ACC_CONF: 100 Hz, normal, perf mode
+        Write(bmi_, 0x41, 0x01);  // ACC_RANGE: +-4 g
+        Write(bmi_, 0x7C, 0x02);  // PWR_CONF: fifo self wake, no adv power save
+        ESP_LOGI("LilTokenSensors", "BMI270 ready");
+        return imu_ok_ = true;
+    }
+
+    bool InitProximity() {
+        ltr_ok_ = false;
+        if (!ltr_dev_) return false;
+        // Gain 48x: at 1x a lit desk read 1 or 2, too little range to tell
+        // lights on from lights off (Lil Token, 9 November 2026).
