+        overlay_fetch_in_progress_.store(false, std::memory_order_release);
+        SendAvatarSetLoaded(ok, ctx->expected_sha256, ok ? "" : error);
+    }
+
+    void ShowOverlay(uint8_t* buffer) {
+        if (display_ == nullptr) return;
+        DisplayLockGuard lock(display_);
+        if (overlay_img_ == nullptr) {
+            lv_obj_t* screen = lv_screen_active();
+            if (screen == nullptr) return;
+            overlay_img_ = lv_image_create(screen);
+            if (overlay_img_ == nullptr) return;
+            lv_image_set_scale(overlay_img_, 512);   // same 2x as the face under it
+            lv_obj_align(overlay_img_, LV_ALIGN_CENTER, 0, 0);
+            lv_obj_clear_flag(overlay_img_, LV_OBJ_FLAG_SCROLLABLE);
+        }
+        overlay_dsc_index_ ^= 1;
+        lv_image_dsc_t& dsc = overlay_dsc_[overlay_dsc_index_];
+        dsc.header.magic = LV_IMAGE_HEADER_MAGIC;
+        dsc.header.cf = LV_COLOR_FORMAT_RGB565A8;
+        dsc.header.flags = 0;
+        dsc.header.w = 160;
+        dsc.header.h = 120;
+        dsc.header.stride = 160 * 2;
+        dsc.data_size = kOverlayBytes;
+        dsc.data = buffer;
+        overlay_current_ = buffer;
+        lv_image_set_src(overlay_img_, &dsc);
+        lv_obj_invalidate(overlay_img_);
+        overlay_active_ = true;
+        // Only over a visible face, never over the camera view.
+        if (avatar_img_ != nullptr && !lv_obj_has_flag(avatar_img_, LV_OBJ_FLAG_HIDDEN) &&
+            viewfinder_frame_ == nullptr) {
+            lv_obj_clear_flag(overlay_img_, LV_OBJ_FLAG_HIDDEN);
+            lv_obj_move_foreground(overlay_img_);
+        } else {
+            lv_obj_add_flag(overlay_img_, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+
+    void ClearOverlay() {
+        if (display_ == nullptr) return;
+        DisplayLockGuard lock(display_);
+        overlay_active_ = false;
+        if (overlay_img_ != nullptr) {
+            lv_obj_add_flag(overlay_img_, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+
