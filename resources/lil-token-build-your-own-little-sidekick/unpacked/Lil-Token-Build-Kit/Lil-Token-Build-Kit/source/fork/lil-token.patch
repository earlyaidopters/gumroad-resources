+    entries_.push_back(Entry{checksum, mode, buffer, size, ++clock_});
+    while (entries_.size() > kMaxSets && EvictOne(keep)) {
+    }
+    ESP_LOGI(TAG, "Avatar set cached (%u on the robot)",
+             static_cast<unsigned int>(entries_.size()));
+}
+
+bool AvatarSetCache::EvictOne(const uint8_t* keep) {
+    int oldest = -1;
+    for (size_t i = 0; i < entries_.size(); ++i) {
+        if (entries_[i].buffer == keep) {
+            continue;
+        }
+        if (oldest < 0 || entries_[i].used < entries_[oldest].used) {
+            oldest = static_cast<int>(i);
+        }
+    }
+    if (oldest < 0) {
+        return false;
+    }
+    ESP_LOGI(TAG, "Avatar set evicted from the cache (%s)", entries_[oldest].checksum.c_str());
+    heap_caps_free(entries_[oldest].buffer);
+    entries_.erase(entries_.begin() + oldest);
+    return true;
+}
