+
+const AvatarSetCache::Entry* AvatarSetCache::Find(const std::string& checksum) {
+    if (checksum.empty()) {
+        return nullptr;
+    }
+    for (auto& e : entries_) {
+        if (e.checksum == checksum) {
+            e.used = ++clock_;
+            return &e;
+        }
+    }
+    return nullptr;
