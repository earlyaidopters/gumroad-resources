        },
        "options": {}
      },
      "id": "3debe2c0-6ded-4553-8b21-a6af7a4d9213",
      "name": "No Articles Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2400,
        272
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-5-nano",
          "mode": "list",
          "cachedResultName": "GPT-5-NANO"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a content curator formatting a daily RSS digest. Today's date is {{ new Date().toLocaleDateString() }}.\\n\\nArticles data (JSON): {{ $json.data.toJsonString() }}\\n\\nFormat these articles into a clean, readable digest for Slack/Discord. Include:\\n- A title header with today's date\\n- Each article as a bullet point with: clickable title link, source name, brief description, and publication date\\n- Use markdown formatting\\n\\nIf there are NO articles, respond with a friendly \\\"No new articles found\\\" message including today's date.\\n\\nProvide ONLY the formatted digest text, ready to post directly."
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        2048,
        80
      ],
      "id": "15b4efcf-cecf-4397-9c85-9ad9d35dddd6",
      "name": "Format Digest with AI",
      "credentials": {
        "openAiApi": {
          "id": "KSKdcXliKjYZC",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Get workflow configuration\nconst config = $('Workflow Configuration').first().json;\n\n// Ensure keywords are arrays (handle different formats)\nconst keywords = Array.isArray(config.keywords) \n  ? config.keywords.map(k => k.toLowerCase()) \n  : [];\n\nconst excludeKeywords = Array.isArray(config.excludeKeywords) \n  ? config.excludeKeywords.map(k => k.toLowerCase()) \n  : [];\n\n// Get all RSS items\nconst items = $('Read RSS Feeds').all();\n\n// Filter function\nconst matchesKeywords = (text) => {\n  if (keywords.length === 0) return true; // If no keywords, include all\n  const lowerText = text.toLowerCase();\n  return keywords.some(keyword => lowerText.includes(keyword));\n};\n\nconst containsExcluded = (text) => {\n  if (excludeKeywords.length === 0) return false; // If no exclusions, exclude none\n  const lowerText = text.toLowerCase();\n  return excludeKeywords.some(keyword => lowerText.includes(keyword));\n};\n\n// Filter items\nconst filtered = items.filter(item => {\n  const title = item.json.title || '';\n  const content = item.json['content:encoded'] || item.json.description || '';\n  const fullText = `${title} ${content}`;\n  \n  // Must match at least one keyword AND not contain excluded keywords\n  return matchesKeywords(fullText) && !containsExcluded(fullText);\n});\n\n// Return filtered items\nreturn filtered;"
      },
