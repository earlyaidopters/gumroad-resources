        "messages": {
          "values": [
            {
              "content": "=For each content topic from the previous step, create platform-specific post versions optimized for LinkedIn, Twitter, and Instagram. Use this data: {{ $('Generate Content Topics').item.json.toJsonString() }} . \n\nFor each topic, create 1 post version with: LinkedIn: Professional tone, 1-3 paragraphs, industry hashtags, call-to-action for engagement. Twitter: Concise, under 280 chars, trending hashtags, clear CTA. Instagram: Visual-focused copy, engaging caption, lifestyle hashtags, story-worthy CTA. Include relevant hashtags (5-10 per platform) and strong calls-to-action. Return as JSON array with objects: originalTitle, platform, postContent, hashtags, callToAction, suggestedDate, category, image prompt for a corresponding image."
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
