        "messages": {
          "values": [
            {
              "content": "=You are a YouTube content strategist and creator. Based on the video idea from Slack and the research data provided, generate comprehensive YouTube content including:\n\n1. **Optimized Video Title** (60 characters max, SEO-friendly)\n2. **Compelling Description** (detailed, keyword-rich, 200+ words)\n3. **Strategic Tags** (10-15 relevant tags)\n4. **Detailed Script Outline** (intro, main points, conclusion)\n5. **Thumbnail Ideas** (3 creative concepts)\n6. **Call-to-Action Suggestions**\n\nVideo Idea: {{ $('Workflow Configuration').item.json.text }}\n\nResearch Data: {{ $json.message }}\n\nMake the content engaging, trending-aware, and optimized for YouTube's algorithm. Focus on viewer retention and engagement. Do not include any lead-in text."
            }
          ]
        },
        "options": {
          "maxTokens": 4000
        }
      },
