# Private local mode: uses the Codex sign-in already present on this machine.
AI_BACKEND=codex-subscription

HOST=127.0.0.1
PORT=3210
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_MS=180000
INTERNAL_TOOL_WORKSPACE=./runtime/workspace

# Optional: omit CODEX_MODEL to use the current Codex default for your account.
CODEX_MODEL=

# API mode only. There is no automatic fallback to this mode.
# AI_BACKEND=openai-api
# OPENAI_API_KEY=
# OPENAI_MODEL=

