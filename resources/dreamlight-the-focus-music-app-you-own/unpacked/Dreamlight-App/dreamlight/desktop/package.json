{
  "name": "dreamlight-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Dreamlight desktop app for Mac and Windows: offline player with a menu bar or tray remote.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "./build-mac.sh",
    "install:mac": "./build-mac.sh --install",
    "build:win": "node build-windows.mjs",
    "install:win": "node build-windows.mjs --install",
    "uninstall:win": "node build-windows.mjs --uninstall"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "@electron/packager": "^19.0.0"
  },
  "productName": "Dreamlight"
}
