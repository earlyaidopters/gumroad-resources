      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 26
    },
    {
      "id": "b6c712eea832450b9ffe",
      "type": "text",
      "x": 70,
      "y": 942.4,
      "width": 730,
      "height": 257.40000000000003,
      "angle": 0,
      "strokeColor": "#161616",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 120,
      "version": 1,
      "versionNonce": 1020,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788800000000,
      "link": null,
      "locked": false,
      "text": "Assume customers and competitors can use Astra to reproduce\ncompetent software quickly. Explain what could be copied in\na weekend, what valuable part would still be missing, and\nwhy a customer would pay instead of building or switching.\nPropose a credible way to earn that advantage from zero,\nincluding a first-customer strategy and an experiment that\ncould disprove it. The product must deliver value before\nthis advantage exists. Treat defensibility as a hypothesis,\nnot an established moat.",
      "originalText": "Assume customers and competitors can use Astra to reproduce\ncompetent software quickly. Explain what could be copied in\na weekend, what valuable part would still be missing, and\nwhy a customer would pay instead of building or switching.\nPropose a credible way to earn that advantage from zero,\nincluding a first-customer strategy and an experiment that\ncould disprove it. The product must deliver value before\nthis advantage exists. Treat defensibility as a hypothesis,\nnot an established moat.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
    },
