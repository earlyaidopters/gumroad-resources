    },
    {
      "id": "401c915d1b604727911a",
      "type": "text",
      "x": 70,
      "y": 1661.4,
      "width": 730,
      "height": 257.40000000000003,
      "angle": 0,
      "strokeColor": "#161616",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 134,
      "version": 1,
      "versionNonce": 1034,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788800000000,
      "link": null,
      "locked": false,
      "text": "Build a polished website that combines the explorable\nproduct plan and working prototype in one experience. Build\nfor one primary user role and one core problem. Implement\none complete workflow with 3–5 meaningful steps and at most\nthree main product screens. Use realistic sample data and\npreserve changes across a refresh. Keep research and\nplanning material in supporting panels. Exclude production\nauthentication, payments, live messaging and external\nintegrations; identify simulated behavior clearly.",
      "originalText": "Build a polished website that combines the explorable\nproduct plan and working prototype in one experience. Build\nfor one primary user role and one core problem. Implement\none complete workflow with 3–5 meaningful steps and at most\nthree main product screens. Use realistic sample data and\npreserve changes across a refresh. Keep research and\nplanning material in supporting panels. Exclude production\nauthentication, payments, live messaging and external\nintegrations; identify simulated behavior clearly.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
