      "text": "02  The evidence",
      "originalText": "02  The evidence",
      "fontSize": 26,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 26
    },
    {
      "id": "7f158171d43747a8b5dd",
      "type": "text",
      "x": 70,
      "y": 511.4,
      "width": 730,
      "height": 286.0,
      "angle": 0,
      "strokeColor": "#161616",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 113,
      "version": 1,
      "versionNonce": 1013,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788800000000,
      "link": null,
      "locked": false,
      "text": "Research real conversations on Reddit and X and examine\nthree existing alternatives. Aim to support the shortlist\nwith six distinct, relevant conversations across those\nplatforms. Look for repeated frustrations, current\nworkarounds, spending signals and counterevidence. Choose\nyour own research methods using the capabilities available\nto you. Link the original sources. Explain access\nlimitations and evidence gaps; do not invent sources to\nmeet a count. Popularity alone is not proof that someone\nwill pay.",
      "originalText": "Research real conversations on Reddit and X and examine\nthree existing alternatives. Aim to support the shortlist\nwith six distinct, relevant conversations across those\nplatforms. Look for repeated frustrations, current\nworkarounds, spending signals and counterevidence. Choose\nyour own research methods using the capabilities available\nto you. Link the original sources. Explain access\nlimitations and evidence gaps; do not invent sources to\nmeet a count. Popularity alone is not proof that someone\nwill pay.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
